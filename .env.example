# Local evaluation works without this file. Change before deployment.
# Use a URL-safe password (letters, digits, hyphens) because it is used in DATABASE_URL.
POSTGRES_PASSWORD=learnbuddy-local-only
WEB_PORT=8080

# Optional: only if Docker cannot reach package registries directly.
# DOCKER_BUILD_HTTP_PROXY=http://host.docker.internal:YOUR_PROXY_PORT
# DOCKER_BUILD_HTTPS_PROXY=http://host.docker.internal:YOUR_PROXY_PORT

# Local mode uses a persistent generated secret and Mailpit (http://localhost:8025).
AUTH_MODE=local
AUTH_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Add your phone preview origin exactly, e.g. http://192.168.1.10:8080.
# Production: AUTH_MODE=production, exact HTTPS origins, random AUTH_SECRET (32+ chars), real SMTP.
# AUTH_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=LearnBuddy <hello@your-domain.example>
